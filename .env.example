# Postgres (Neon / Vercel Postgres). Use the pooled connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Public site URL, used for the YooKassa return link
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel: /admin
ADMIN_PASSWORD=change-me
# Random string, at least 32 characters (signs the admin session cookie)
ADMIN_SECRET=replace-with-a-long-random-string-0123456789

# YooKassa. Leave empty to use the built-in demo payment (always succeeds).
# For the YooKassa test shop use its shopId and test_... secret key.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Set to true to send 54-FZ receipts through YooKassa (needs receipts enabled in the shop)
YOOKASSA_SEND_RECEIPT=false

# Telegram notifications about new paid orders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Blob for images uploaded in the admin panel (set automatically when you add Blob storage on Vercel).
# Without it, uploads are saved to public/uploads (works only locally).
BLOB_READ_WRITE_TOKEN=
